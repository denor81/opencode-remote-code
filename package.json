{
  "name": "opencode-ssh",
  "version": "0.1.0",
  "description": "Run OpenCode locally while project tools operate through system OpenSSH; tested against OpenCode 1.18.18",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "opencode-ssh": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/installation-and-usage.md",
    "docs/upstream-fit-checklist.md",
    "docs/upstream-fit-report.md",
    "opencode-ssh-remote-use/opencode-ssh-agent-self-test.md",
    "opencode-ssh-remote-use/opencode-ssh-safety.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "UPSTREAM.md"
  ],
  "scripts": {
    "build": "node scripts/clean.cjs && tsc -p tsconfig.json",
    "postbuild": "node scripts/postbuild.cjs",
    "prepack": "npm run build",
    "install:verified": "node scripts/install-verified.cjs",
    "dev": "tsc --watch",
    "lint": "npm run lint:src && npm run lint:test",
    "lint:src": "tsc --noEmit",
    "lint:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run test/unit test/integration && vitest run test/smoke",
    "test:unit": "vitest run test/unit",
    "test:integration": "npm run build && vitest run test/integration",
    "test:task-baseline": "npm run build && node scripts/run-task-baseline.cjs",
    "test:smoke": "npm run build && vitest run test/smoke",
    "test:real": "npm run build && vitest run test/real"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.18",
    "diff": "9.0.0",
    "effect": "4.0.0-beta.83",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "1.18.18",
    "@types/node": "22.17.1",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/denor81/opencode-remote-code.git"
  },
  "bugs": {
    "url": "https://github.com/denor81/opencode-remote-code/issues"
  },
  "homepage": "https://github.com/denor81/opencode-remote-code#readme",
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "ssh",
    "remote",
    "agent"
  ]
}
