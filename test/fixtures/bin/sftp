#!/usr/bin/env node

import {
  appendFileSync,
  copyFileSync,
  mkdirSync,
  writeFileSync,
} from "node:fs"
import path from "node:path"

const args = process.argv.slice(2)
const logPath = process.env.FAKE_SFTP_LOG
if (logPath) appendFileSync(logPath, `${JSON.stringify(args)}\n`)

const input = await readStdin()
if (process.env.FAKE_SFTP_INPUT) writeFileSync(process.env.FAKE_SFTP_INPUT, input)
if (process.env.FAKE_SFTP_INPUT_LOG) {
  appendFileSync(process.env.FAKE_SFTP_INPUT_LOG, `${JSON.stringify(input)}\n`)
}

const expectedInput = process.env.FAKE_SFTP_EXPECT_INPUT
if (expectedInput !== undefined && input !== expectedInput) {
  process.stderr.write("unexpected SFTP batch input")
  process.exit(2)
}

const commands = input.endsWith("\n") ? input.slice(0, -1).split("\n") : input.split("\n")
if (commands.length !== 1 || !/^(get|put) /.test(commands[0])) {
  process.stderr.write("fake sftp accepts exactly one get or put command")
  process.exit(2)
}

const delayMs = numberFromEnv("FAKE_SFTP_DELAY_MS") ?? 0
if (delayMs > 0) await new Promise((resolve) => setTimeout(resolve, delayMs))

if (process.env.FAKE_REMOTE_ROOT) emulateRemoteTransfer(commands[0])

if (process.env.FAKE_SFTP_STDOUT) process.stdout.write(process.env.FAKE_SFTP_STDOUT)
if (process.env.FAKE_SFTP_STDERR) process.stderr.write(process.env.FAKE_SFTP_STDERR)
process.exit(numberFromEnv("FAKE_SFTP_EXIT_CODE") ?? 0)

async function readStdin() {
  process.stdin.setEncoding("utf8")
  let value = ""
  for await (const chunk of process.stdin) value += chunk
  return value
}

function numberFromEnv(name) {
  const value = process.env[name]
  if (value === undefined) return undefined
  const parsed = Number(value)
  return Number.isFinite(parsed) ? parsed : undefined
}

function emulateRemoteTransfer(command) {
  const [operation, source, destination] = parseBatchCommand(command)
  if (!operation || !source || !destination) {
    process.stderr.write("invalid fake SFTP batch command")
    process.exit(2)
  }

  try {
    if (operation === "get") {
      mkdirSync(path.dirname(destination), { recursive: true })
      copyFileSync(remotePath(source), destination)
    } else {
      const target = remotePath(destination)
      mkdirSync(path.dirname(target), { recursive: true })
      copyFileSync(source, target)
    }
  } catch (error) {
    if (operation === "get" && error?.code === "ENOENT") {
      process.stderr.write(`File ${source} not found\n`)
      process.exit(1)
    }
    process.stderr.write(`fake SFTP ${operation} failed: ${error instanceof Error ? error.message : String(error)}\n`)
    process.exit(2)
  }
  process.exit(0)
}

function parseBatchCommand(command) {
  const words = []
  let current = ""
  let escaped = false
  for (const character of command) {
    if (escaped) {
      current += character
      escaped = false
    } else if (character === "\\") {
      escaped = true
    } else if (/\s/u.test(character)) {
      if (current) {
        words.push(current)
        current = ""
      }
    } else {
      current += character
    }
  }
  if (escaped) throw new Error("fake SFTP command ended with an escape")
  if (current) words.push(current)
  return words
}

function remotePath(remote) {
  const root = process.env.FAKE_REMOTE_ROOT
  if (!root || !path.posix.isAbsolute(remote) || path.posix.normalize(remote) !== remote) {
    throw new Error(`invalid fake remote path ${JSON.stringify(remote)}`)
  }
  const local = path.resolve(root, `.${remote}`)
  if (local !== root && !local.startsWith(`${root}${path.sep}`)) {
    throw new Error(`fake remote path escaped its root: ${JSON.stringify(remote)}`)
  }
  return local
}
